        const fnStr = fn.toString();

        // Framework data capture
        if (fnStr.includes('switch (fw)') || fnStr.includes('__NEXT_DATA__')) {
          if (arg === 'next') {
            return {
              props: { pageProps: { user: 'test' } },
              page: '/dashboard',
              query: {},
              buildId: 'abc123'
            };
          }
          return null;

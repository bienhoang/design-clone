});

// ========================================
// Test: Deep filtering with nested sensitive keys
// ========================================
test('filterSensitive handles deeply nested sensitive keys', async () => {
  const warnings = [];
  const input = {
    level1: {
      level2: {
        level3: {
          secretKey: 'hidden',
          normalData: 'visible'
        }
      }
    }
  };


});

// ========================================
// Test: enforceStateLimit truncates large state
// ========================================
test('enforceStateLimit truncates large state', async () => {
  const warnings = [];
  // Create a large state (~2MB)
  const largeArray = new Array(50000).fill('x'.repeat(50));
  const snapshot = {
    frameworkData: null,
    storeState: { data: largeArray },
    framework: 'react',
    storeType: 'redux',
    warnings,
    capturedAt: Date.now(),
